    "settings.ai.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is stored in the Keychain and sent only to api.anthropic.com. Photos and descriptions are sent to the model to estimate nutrition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave è salvata nel Portachiavi e inviata solo ad api.anthropic.com. Foto e descrizioni vengono inviate al modello per stimare i valori nutrizionali."
          }
        }
      }
    },
    "settings.language.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacroLog follows the language of your device. You can choose a different language for this app from the system settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacroLog segue la lingua del dispositivo. Puoi scegliere una lingua diversa per questa app dalle impostazioni di sistema."
          }
        }
      }
    },
