    "onboarding.activity.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only for the first estimate. After a week of logging, your real data takes over."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato solo per la prima stima. Dopo una settimana di registrazioni, prendono il sopravvento i tuoi dati reali."
          }
        }
      }
    },
    "onboarding.goal.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change goal and strategy at any time in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare obiettivo e strategia in qualsiasi momento nelle Impostazioni."
          }
        }
      }
    },
    "onboarding.welcome.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacroLog learns your real energy expenditure from the weight and food you log, and adjusts your daily calorie and macro targets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacroLog impara la tua spesa energetica reale dal peso e dal cibo che registri e aggiorna i tuoi obiettivi giornalieri di calorie e macronutrienti."
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track meals, hit your macros, reach your goal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i pasti, centra i macro, raggiungi il tuo obiettivo."
          }
        }
      }
    },
    "over": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "in eccesso"
          }
        }
      }
    },
