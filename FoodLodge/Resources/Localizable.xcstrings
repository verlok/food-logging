    "onboarding.activity.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only for the first estimate. After a week of logging, your real data takes over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa solo para la primera estimación. Tras una semana de registros, tus datos reales toman el relevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement pour la première estimation. Après une semaine de suivi, vos données réelles prennent le relais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato solo per la prima stima. Dopo una settimana di registrazioni, prendono il sopravvento i tuoi dati reali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado apenas para a primeira estimativa. Após uma semana de registros, seus dados reais assumem."
          }
        }
      }
    },
    "onboarding.goal.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change goal and strategy at any time in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el objetivo y la estrategia en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier l'objectif et la stratégie à tout moment dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare obiettivo e strategia in qualsiasi momento nelle Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar a meta e a estratégia a qualquer momento em Ajustes."
          }
        }
      }
    },
    "onboarding.welcome.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge learns your real energy expenditure from the weight and food you log, and adjusts your daily calorie and macro targets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge aprende tu gasto energético real a partir del peso y la comida que registras, y ajusta tus objetivos diarios de calorías y macronutrientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge apprend votre dépense énergétique réelle à partir du poids et des aliments que vous enregistrez, et ajuste vos objectifs quotidiens de calories et de macronutriments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge impara la tua spesa energetica reale dal peso e dal cibo che registri e aggiorna i tuoi obiettivi giornalieri di calorie e macronutrienti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Food Lodge aprende seu gasto energético real a partir do peso e da comida que você registra, e ajusta suas metas diárias de calorias e macronutrientes."
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track meals, hit your macros, reach your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tus comidas, cumple tus macros, alcanza tu objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos repas, atteignez vos macros, réalisez votre objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i pasti, centra i macro, raggiungi il tuo obiettivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre suas refeições, acerte seus macros, alcance sua meta."
          }
        }
      }
    },
