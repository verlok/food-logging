    "settings.ai.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is stored in the Keychain and sent only to api.anthropic.com. Photos and descriptions are sent to the model to estimate nutrition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave se guarda en el llavero y se envía solo a api.anthropic.com. Las fotos y descripciones se envían al modelo para estimar los valores nutricionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé est stockée dans le trousseau et envoyée uniquement à api.anthropic.com. Les photos et descriptions sont envoyées au modèle pour estimer les valeurs nutritionnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave è salvata nel Portachiavi e inviata solo ad api.anthropic.com. Foto e descrizioni vengono inviate al modello per stimare i valori nutrizionali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave é armazenada nas Chaves e enviada apenas para api.anthropic.com. Fotos e descrições são enviadas ao modelo para estimar os valores nutricionais."
          }
        }
      }
    },
    "settings.language.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge follows the language of your device. You can choose a different language for this app from the system settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge sigue el idioma del dispositivo. Puedes elegir otro idioma para esta app en los ajustes del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge suit la langue de votre appareil. Vous pouvez choisir une autre langue pour cette app dans les réglages du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Food Lodge segue la lingua del dispositivo. Puoi scegliere una lingua diversa per questa app dalle impostazioni di sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Food Lodge segue o idioma do dispositivo. Você pode escolher outro idioma para este app nos ajustes do sistema."
          }
        }
      }
    },
