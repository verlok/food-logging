    "expenditure.method.formula": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from your profile. Log your weight and food daily: after a week the estimate adapts to your real data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de tu perfil. Registra tu peso y tu comida cada día: tras una semana, la estimación se adapta a tus datos reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimée à partir de votre profil. Enregistrez votre poids et votre alimentation chaque jour : après une semaine, l'estimation s'adapte à vos données réelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimata dal tuo profilo. Registra peso e cibo ogni giorno: dopo una settimana la stima si adatta ai tuoi dati reali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir do seu perfil. Registre seu peso e sua comida todos os dias: após uma semana, a estimativa se adapta aos seus dados reais."
          }
        }
      }
    },
